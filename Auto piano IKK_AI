local function loadSource(fn, srcName, ...)
    local args = { ... }
    loadingCount += 1
    task.spawn(function()
        local ok, n, errNote = pcall(fn, table.unpack(args))
        loadingCount -= 1
        if ok and type(n) == "number" and n > 0 then
            sortSongs()
        elseif ok and type(errNote) == "string" then
            setStatus((srcName or "Source") .. ": " .. errNote .. " · press 🔄 to retry", "warn", 10)
        end
        queueRender()
    end)
end

local function reloadSources()
    if loadingCount > 0 then return setStatus("Still loading…", "warn", 3) end
