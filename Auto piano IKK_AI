local function loadData()
    if not (readfile and isfile) then return end
    local ok, raw = pcall(function()
        if isfile(DATA_FILE) then return readfile(DATA_FILE) end
    end)
    if not ok or not raw then return end
    local okJ, d = pcall(HttpService.JSONDecode, HttpService, raw)
    if not okJ or type(d) ~= "table" then return end
    if type(d.speed) == "number" then setSpeed(d.speed) end
    if type(d.mode) == "number" and modeNames[d.mode] then modeIdx = d.mode refreshModes() end
    if type(d.auto) == "number" and autoNames[d.auto] then autoIdx = d.auto refreshAuto() end
    if type(d.lyrics) == "boolean" then lyricsOn = d.lyrics refreshLyrBtn() end
    if type(d.titles) == "table" then
        for _, t in ipairs(d.titles) do
            if type(t) == "table" and type(t.file) == "string" and type(t.title) == "string" then
                fileTitles[t.file] = t.title
            end
        end
    end
    if type(d.pins) == "table" then
        for _, p in ipairs(d.pins) do
            if type(p) == "table" and p.label then
                local fields = { tag = p.tag or "Pin", url = p.url, page = p.page, localPath = p.localPath }
                addSong(tostring(p.label), fields)
                local key = p.url or p.page or p.localPath
                if key then pins[key] = true end
            end
        end
    end
end

local UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0 Safari/537.36"

local function headerOf(res, name)
    local h = res and res.Headers
    if type(h) ~= "table" then return nil end
    local want = name:lower()
    for k, v in pairs(h) do
        if type(k) == "string" and k:lower() == want then return tostring(v) end
    end
    return nil
end

-- GET that survives flaky mobile networks: it retries, checks Content-Length,
-- and resumes with a Range request when the body arrives cut short
local function httpGet(url)
    if not httpRequest then return nil end
    local body = nil
    for attempt = 1, 3 do
        local ok, res = pcall(httpRequest, { Url = url, Method = "GET", Headers = { ["User-Agent"] = UA } })
        if ok and res and res.StatusCode and res.StatusCode >= 200 and res.StatusCode < 300
            and type(res.Body) == "string" then
            body = res.Body
            local want = tonumber(headerOf(res, "content-length"))
            if not want or #body >= want then return body end
            -- cut short: ask the server for the missing part
            for _ = 1, 8 do
                local ok2, r2 = pcall(httpRequest, {
                    Url = url, Method = "GET",
                    Headers = { ["User-Agent"] = UA, ["Range"] = "bytes=" .. #body .. "-" },
                })
                if not (ok2 and r2 and r2.StatusCode and r2.StatusCode < 300
                    and type(r2.Body) == "string" and #r2.Body > 0) then break end
                if r2.StatusCode == 206 then
                    body = body .. r2.Body   -- continuation
                else
                    body = r2.Body           -- server ignored Range: a full body again
                end
                if not want or #body >= want then return body end
            end
        end
        if attempt < 3 then task.wait(0.4 + attempt * 0.3) end
    end
    return body -- best effort: may be nil or partial (callers check the MIDI structure)
end

local function loadNanoMidi()
    local body = httpGet("https://api.nanomidi.net/api/midiData")
    if not body then return 0, "โหลดลิสต์ไม่ได้ (เน็ตหลุดหรือโดนบล็อก?)" end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
    if not ok or type(data) ~= "table" then return 0, "อ่านข้อมูลลิสต์ไม่ได้" end
    local n = 0
    for _, s in ipairs(data) do
        if type(s) == "table" and type(s.midiFilename) == "string" and s.midiFilename ~= "" then
            local file = s.midiFilename
            local url = "https://api.nanomidi.net/api/midis/" .. urlEncode(file)
            local name = realText(s.name or s.title or s.songName)
            if name == "" then name = cleanName(file) end -- no title in the API: use the file name
            local artist = realText(s.artists or s.artist)
            local label = (artist ~= "") and (name .. " - " .. artist) or name
            if addSong(label, { url = url, tag = "Nano" }) then n += 1 end
        end
    end
    return n
end

