---------------------------------------------------------------------
-- Note mapping
---------------------------------------------------------------------
local hasBlackKeys, buildMapper
do
local majorDegree = { [0] = 0, [1] = 0, [2] = 1, [3] = 1, [4] = 2, [5] = 3, [6] = 3, [7] = 4, [8] = 4, [9] = 5, [10] = 5, [11] = 6 }
local inMajor = { [0] = true, [2] = true, [4] = true, [5] = true, [7] = true, [9] = true, [11] = true }

local function detectTonic(notes)
    local hist = {}
    for i = 0, 11 do hist[i] = 0 end
    for _, n in ipairs(notes) do
        local pc = n.n % 12
        hist[pc] = hist[pc] + 1
    end
    local best, bestScore, bestTie = 0, -1, -1
    for t = 0, 11 do
        local score = 0
        for pc = 0, 11 do
            if inMajor[(pc - t) % 12] then score = score + hist[pc] end
        end
        local tie = hist[t] + hist[(t + 7) % 12]
        if score > bestScore or (score == bestScore and tie > bestTie) then
            best, bestScore, bestTie = t, score, tie
        end
    end
    return best
end

function hasBlackKeys(keys)
    local minH, maxH, minY, maxY = math.huge, 0, math.huge, -math.huge
    for _, k in ipairs(keys) do
        minH = math.min(minH, k.h)
        maxH = math.max(maxH, k.h)
        minY = math.min(minY, k.y)
        maxY = math.max(maxY, k.y)
    end
    return (maxH / math.max(minH, 1) >= 1.25) or (maxY - minY > 0.15 * maxH)
end

function buildMapper(notes, N, diatonic)
    local tonic = diatonic and detectTonic(notes) or 0
    local unit = diatonic and 7 or 12

    local function toVal(note)
        if diatonic then
            local d = note - tonic
            return math.floor(d / 12) * 7 + majorDegree[d % 12]
        end
        return note
    end

    local counts, vals = {}, {}
    local minV, maxV = math.huge, -math.huge
    for _, n in ipairs(notes) do
        local v = toVal(n.n)
        counts[v] = (counts[v] or 0) + 1
        vals[#vals + 1] = v
        if v < minV then minV = v end
        if v > maxV then maxV = v end
    end
    table.sort(vals)
    local med = vals[math.ceil(#vals / 2)] or 0

    local bestBase, bestOut, bestDist = 0, math.huge, math.huge
    for base = (math.floor(minV / unit) - 1) * unit, maxV, unit do
        local out = 0
        for v, c in pairs(counts) do
            if v < base or v > base + N - 1 then out = out + c end
        end
        local dist = math.abs(base + N / 2 - med)
        if out < bestOut or (out == bestOut and dist < bestDist) then
            bestBase, bestOut, bestDist = base, out, dist
        end
    end

    return function(note)
        local idx = toVal(note) - bestBase
        if N >= unit then
            while idx < 0 do idx = idx + unit end
            while idx >= N do idx = idx - unit end
        else
            idx = idx % N
        end
        return idx
    end
end
end -- do (note mapping)

