local function new(class, props, parent)
    local i = Instance.new(class)
    for k, v in pairs(props) do i[k] = v end
    i.Parent = parent
    return i
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
local function stroke(o, color, th, tr)
    return new("UIStroke", {
        Color = color, Thickness = th or 1, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, o)
end
local function gradient(o, c1, c2, rot)
    return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rot or 0 }, o)
end
local function pad(o, l, t, r, b)
    new("UIPadding", {
        PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t or l),
        PaddingRight = UDim.new(0, r or l), PaddingBottom = UDim.new(0, b or t or l),
    }, o)
end
local function tween(o, t, props)
    TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end
local function label(parent, props)
    props.BackgroundTransparency = 1
    props.Font = props.Font or FONT
    props.TextColor3 = props.TextColor3 or C.text
    props.TextSize = props.TextSize or 13
    return new("TextLabel", props, parent)
end
local function button(parent, props, base, over)
    props.AutoButtonColor = false
    props.BackgroundColor3 = base
    props.Font = props.Font or FONT_B
    props.TextColor3 = props.TextColor3 or C.text
    props.TextSize = props.TextSize or 13
    local b = new("TextButton", props, parent)
    b.MouseEnter:Connect(function() tween(b, 0.12, { BackgroundColor3 = over }) end)
    b.MouseLeave:Connect(function() tween(b, 0.12, { BackgroundColor3 = base }) end)
    return b
end
local function esc(s)
    return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end
local function fmt(sec)
    sec = math.max(0, math.floor(sec))
    return string.format("%d:%02d", sec // 60, sec % 60)
end

