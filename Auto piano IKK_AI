local function singleChar(s)
    if type(s) == "string" and #s == 1 and s:match("^[%w!@#%$%%%^&%*%(%)]$") then
        return s
    end
    return nil
end

local function rawCenter(o)
    local sg = o:FindFirstAncestorOfClass("ScreenGui")
    local c = o.AbsolutePosition + o.AbsoluteSize / 2
    if sg and not sg.IgnoreGuiInset then
        c = c + GuiService:GetGuiInset()
    end
    return c
end

-- exact on-screen position of the glyph inside a text object (honours text alignment)
local function isLetterObj(o)
    return (o:IsA("TextLabel") or o:IsA("TextButton")) and singleChar(o.Text) ~= nil
end

local function textPoint(t)
    local ap, as, tb = t.AbsolutePosition, t.AbsoluteSize, t.TextBounds
    local x, y = as.X / 2, as.Y / 2
    if tb.X > 0 and tb.Y > 0 then
        if t.TextXAlignment == Enum.TextXAlignment.Left then
            x = tb.X / 2
        elseif t.TextXAlignment == Enum.TextXAlignment.Right then
            x = as.X - tb.X / 2
        end
        if t.TextYAlignment == Enum.TextYAlignment.Top then
            y = tb.Y / 2
        elseif t.TextYAlignment == Enum.TextYAlignment.Bottom then
            y = as.Y - tb.Y / 2
        end
    end
    local c = Vector2.new(ap.X + math.clamp(x, 0, as.X), ap.Y + math.clamp(y, 0, as.Y))
    local sg = t:FindFirstAncestorOfClass("ScreenGui")
    if sg and not sg.IgnoreGuiInset then
        c = c + GuiService:GetGuiInset()
    end
    return c
end

-- the single-character label that belongs to a key (the key itself or a visible child)
local function findLetter(o)
    if isLetterObj(o) then return o end
    for _, d in ipairs(o:GetDescendants()) do
        if d:IsA("GuiObject") and d.Visible and isLetterObj(d) then return d end
    end
    return nil
end

local function keyPoint(k)
    if k.ref and k.ref.Parent then return textPoint(k.ref) end
    return rawCenter(k.obj)
end

local flash = function() end

local pressMany
do
local touchOk = pcall(function() return VIM.SendTouchEvent end)
local touchId = 0

local function tapKey(k)
    if not k.obj.Parent then return end
    local c = keyPoint(k) -- exactly on the letter, recomputed at tap time
    if touchOk then
        touchId = touchId % 200 + 1
        local id = touchId
        local ok = pcall(function() VIM:SendTouchEvent(id, 0, c.X, c.Y) end)
        if ok then
            task.wait(0.035)
            pcall(function() VIM:SendTouchEvent(id, 2, c.X, c.Y) end)
            return
        end
        touchOk = false
    end
    VIM:SendMouseMoveEvent(c.X, c.Y, game)
    VIM:SendMouseButtonEvent(c.X, c.Y, 0, true, game, 0)
    task.wait(0.03)
    VIM:SendMouseButtonEvent(c.X, c.Y, 0, false, game, 0)
end

function pressMany(keys)
    for _, k in ipairs(keys) do
        task.spawn(tapKey, k)
        flash(k.i)
    end
end
