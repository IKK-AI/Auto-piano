    local n = 0

    local function addPath(path)
        if type(path) == "string" and path:lower():match("%.midi?$") then
            local name = cleanName(path:match("([^/]+)$") or path)
            local url = ("https://raw.githubusercontent.com/%s/%s/%s"):format(src.repo, branch, urlEncode(path))
            local folder = path:match("([^/]+)/[^/]+$") or ""
            if addSong(name, { url = url, tag = tag, folder = folder }) then n += 1 end
        end
    end

    -- 1) GitHub's tree API (rate limited to ~60 requests/hour per IP)
    local body = httpGet(("https://api.github.com/repos/%s/git/trees/%s?recursive=1"):format(src.repo, branch))
    if body then
        local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
        if ok and type(data) == "table" and type(data.tree) == "table" and not data.truncated then
            for _, item in ipairs(data.tree) do
                if item.type == "blob" then addPath(tostring(item.path)) end
            end
            if n > 0 then return n end
        end
    end

    -- 2) rate limited / failed / truncated: the same file list via jsDelivr (no such limit)
    local function viaJSD(ref)
        local b = httpGet(("https://data.jsdelivr.com/v1/packages/gh/%s@%s"):format(src.repo, ref))
        if not b then return false end
        local ok, data = pcall(HttpService.JSONDecode, HttpService, b)
        if not ok or type(data) ~= "table" or type(data.files) ~= "table" then return false end
        local flat = {}
        local function walk(node, prefix)
            for _, f in ipairs(node.files or {}) do
                local p = (prefix == "") and f.name or (prefix .. "/" .. f.name)
                if f.type == "directory" then
                    walk(f, p)
                else
                    flat[#flat + 1] = p
                end
            end
        end
        walk(data, "")
        for _, p in ipairs(flat) do addPath(p) end
        return true
    end
    for _, ref in ipairs({ src.branch, "master", "main" }) do
        if ref and viaJSD(ref) then break end
    end
    if n == 0 then return 0, "โหลดลิสต์ไม่ได้ (GitHub อาจจำกัดชั่วคราว)" end
    return n
end

local function loadLocal()
    if not (listfiles and readfile and isfolder) then return 0 end
    pcall(function() if makefolder and not isfolder(LOCAL_FOLDER) then makefolder(LOCAL_FOLDER) end end)
    if not isfolder(LOCAL_FOLDER) then return 0 end
    local n = 0
    local function walk(dir, depth)
        local ok, files = pcall(listfiles, dir)
        if not ok then return end
        for _, f in ipairs(files) do
            if f:lower():match("%.midi?$") then
                local base = (f:gsub("\\", "/")):match("([^/]+)$") or f
                local name = cleanName(base)
                if addSong(name, { localPath = f, tag = "Local" }) then
                    n += 1
                    -- a nicer display title for songs transcribed earlier
                    local title = fileTitles[base]
                    if title then
                        local sg = songs[#songs]
                        sg.label = title
                        sg.sk = norm(title)
                        sg.l = sg.sk .. " " .. norm(base)
                        sg.l2 = (sg.l:gsub(" ", ""))
                    end
                end
            elseif depth < 3 then
                local isF = false
                pcall(function() isF = isfolder(f) end)
                if isF then walk(f, depth + 1) end
            end
        end
    end
    walk(LOCAL_FOLDER, 0)
    return n
end

local function searchBitMidi(q)
    local n = 0
    for page = 1, 5 do
        local html = httpGet("https://bitmidi.com/search?q=" .. HttpService:UrlEncode(q) .. "&page=" .. page)
        if not html then break end
        local before = n
        for slug in html:gmatch('href="/([^"/%s]+%-mid)"') do
            -- readable title from the url slug: decode %XX, dashes -> spaces, Title Case
            local name = urlDecode((slug:gsub("%-mid$", "")))
            name = name:gsub("%-", " ")
            name = name:gsub("(%a)([%w']*)", function(a, b) return a:upper() .. b end)
            if addSong(name, { page = "https://bitmidi.com/" .. slug, tag = "BitMidi" }) then n += 1 end
        end
        if n == before then break end
    end
    return n
end

local function fetchBody(s, noCache)
    -- noCache = fetch again under a slightly different URL, in case a proxy/CDN
    -- served a cut-off copy the first time
    local function bust(u)
        if not noCache or type(u) ~= "string" then return u end
        return u .. (u:find("?", 1, true) and "&" or "?") .. "__ap=" .. tostring(math.random(1, 999999))
    end
    if s.body then return s.body end
    if s.localPath then
        local ok, d = pcall(readfile, s.localPath)
        return ok and d or nil
    end
    if s.page then
        local html = httpGet(bust(s.page))
        if not html then return nil end
        local path = html:match('href="(/uploads/[^"]-%.mid)"') or html:match('"(/uploads/[^"]-%.mid)"')
        if not path then return nil end
        return httpGet(bust("https://bitmidi.com" .. path))
    end
    if s.url then
        local body = httpGet(bust(s.url))
        -- raw.githubusercontent.com is unreachable in some places: same file via jsDelivr
        if not body and type(s.url) == "string" and s.url:find("raw.githubusercontent.com", 1, true) then
            local alt = s.url:gsub("^https://raw%.githubusercontent%.com/([^/]+)/([^/]+)/([^/]+)/", "https://cdn.jsdelivr.net/gh/%1/%2@%3/")
            body = httpGet(bust(alt))
        end
        return body
    end
    return nil
end

