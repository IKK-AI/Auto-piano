-- Player engine: real-time speed, seek, pause, auto-advance
---------------------------------------------------------------------
local token = 0          -- bumps whenever a new song starts / playback stops
-- lyrics (LRCLIB, time-synced) ------------------------------------
local lyr = nil          -- { {t = seconds, text = "..."}, ... } for the current song
local lyrIdx = 0

local loadLyrics
do
local function parseLrc(txt)
    local out = {}
    for line in txt:gmatch("[^\r\n]+") do
        local text = trim((line:gsub("%[[^%]]*%]", "")))
        for m, sc in line:gmatch("%[(%d+):(%d+%.?%d*)%]") do
            out[#out + 1] = { t = tonumber(m) * 60 + tonumber(sc), text = text }
        end
    end
    table.sort(out, function(a, b) return a.t < b.t end)
    return out
end

function loadLyrics(s, my)
    lyr, lyrIdx = nil, 0
    if not lyricsOn then return end
    if s.lyr == nil then
        s.lyr = false -- cached per song (false = none found)
        local q = trim((s.label:gsub("%b()", " "):gsub(" %- ", " ")))
        if q ~= "" then
            local body = httpGet("https://lrclib.net/api/search?q=" .. HttpService:UrlEncode(q))
            if body then
                local ok, data = pcall(HttpService.JSONDecode, HttpService, body)
                if ok and type(data) == "table" then
                    for _, r in ipairs(data) do
                        if type(r) == "table" and type(r.syncedLyrics) == "string" and r.syncedLyrics ~= "" then
                            local lines = parseLrc(r.syncedLyrics)
                            if #lines > 0 then
                                s.lyr = lines
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    if my == token and s.lyr then lyr = s.lyr end
end
end -- do (lyrics)

local cur = nil          -- { notes, total } for the loaded song
local pos, idx = 0, 1    -- playhead (song seconds) and next note index
local scrub = nil        -- seconds while the progress bar is being dragged
local failStreak = 0
local lastSec, lastTotal = -1, -1

local function updatePlayBtn()
    playBtn.Text = (playing and cur and not paused) and "❚❚" or "▶"
end

local function updateProgress(force)
    local total = cur and cur.total or 0
    local p = scrub or pos
    local r = total > 0 and math.clamp(p / total, 0, 1) or 0
    barFill.Size = UDim2.new(r, 0, 1, 0)
    knob.Position = UDim2.new(r, 0, 0.5, 0)
    local sec = math.floor(p)
    if force or sec ~= lastSec or total ~= lastTotal then
        lastSec, lastTotal = sec, total
        timeL.Text = fmt(p)
        timeR.Text = fmt(total)
    end
    -- lyric line that matches the playhead
    if lyr and lyricsOn then
        local i = lyrIdx
        while i < #lyr and lyr[i + 1].t <= p do i += 1 end
        while i > 0 and lyr[i].t > p do i -= 1 end
        if i ~= lyrIdx then
            lyrIdx = i
            lyricLabel.Text = (i > 0) and lyr[i].text or ""
        end
    end
end

local function firstIdx(notes, t)
    local lo, hi = 1, #notes + 1
    while lo < hi do
        local mid = (lo + hi) // 2
        if notes[mid].time < t then lo = mid + 1 else hi = mid end
    end
    return lo
end

local function seekTo(t)
    if not cur then return end
    pos = math.clamp(t, 0, cur.total)
    idx = firstIdx(cur.notes, pos)
    updateProgress(true)
end

stopAll = function()
    token += 1
    playing, paused, cur = false, false, nil
    pos, idx, scrub = 0, 1, nil
    lyr, lyrIdx = nil, 0
    lyricLabel.Text = ""
    refreshPlayingUI()
    updatePlayBtn()
    updateProgress(true)
end

-- runs one song until it ends / fails / is replaced. returns "done" | "fail" | "stop" | "superseded"
local function runSong(s, my)
    pcall(scan)
    updateMarkers()
    if #detected == 0 then
        setStatus("No keys detected. Move the box over the piano.", "bad", 3)
        return "stop"
    end
    local keys = detected
    local N = #keys

    setStatus("Loading…", "play")
    local body = fetchBody(s)
    if my ~= token then return "superseded" end
    if not body then
        setStatus("Download failed · skipping", "bad", 3)
        return "fail"
    end
    if body:sub(1, 4) ~= "MThd" then
        setStatus("Not a MIDI file · skipping", "bad", 3)
        return "fail"
    end
    local okP, notes, truncated = pcall(parseMidi, body)
    local nCount = (okP and type(notes) == "table") and #notes or 0
    if okP and truncated then
        -- the file arrived cut short: try once more, keep whichever copy has more notes
        setStatus("File incomplete · re-downloading…", "warn", 4)
        local again = fetchBody(s, true)
        if again and again ~= body and again:sub(1, 4) == "MThd" then
            local ok2, n2, tr2 = pcall(parseMidi, again)
            local n2Count = (ok2 and type(n2) == "table") and #n2 or 0
            if n2Count > nCount then
                body, notes, okP, nCount, truncated = again, n2, ok2, n2Count, tr2
            end
        end
        if my ~= token then return "superseded" end
    end
    if nCount == 0 then
        setStatus("MIDI unreadable · skipping", "bad", 3)
        return "fail"
    end

    local diatonic
    if modeIdx == 1 then diatonic = not hasBlackKeys(keys) else diatonic = (modeIdx == 3) end
    local mapper = buildMapper(notes, N, diatonic)
    local maxChord = (N <= 15) and 2 or 4

    cur = { notes = notes, total = math.max(notes[#notes].time, 0.001) }
    pos, idx, paused = 0, 1, false
    task.spawn(loadLyrics, s, my)
    updatePlayBtn()
    updateProgress(true)
    setStatus((diatonic and "Diatonic" or "Chromatic") .. " · " .. N .. " keys"
        .. (truncated and " · incomplete file — may stop early" or ""), "play")

    while true do
        local dt = task.wait()
        if my ~= token then return "superseded" end
        if not paused then pos += math.min(dt, 0.25) * speed end -- speed is read every frame = real time
        if pos > cur.total + 0.4 then return "done" end

        while idx <= #notes and notes[idx].time <= pos do
            local t = notes[idx].time
            local group, j = {}, idx
            while j <= #notes and notes[j].time - t < 0.01 do
                group[#group + 1] = notes[j].n
                j += 1
            end
            idx = j
            table.sort(group, function(a, b) return a > b end)
            local chord, seen = {}, {}
            for _, nn in ipairs(group) do
                local k = mapper(nn)
                if not seen[k] and keys[k + 1] then
                    seen[k] = true
                    chord[#chord + 1] = keys[k + 1]
                    if #chord >= maxChord then break end
                end
            end
            if #chord > 0 then task.spawn(pressMany, chord) end
        end
        updateProgress()
    end
end

playSong = function(s, keepQueue)
    if not keepQueue then setQueueFrom(s) end
    token += 1
    local my = token
    selected = s
    songLabel.Text = s.label
    updatePinBtn()
    highlightRows()
    cur, pos, idx, paused, scrub = nil, 0, 1, false, nil
    lyr, lyrIdx = nil, 0
    lyricLabel.Text = ""
    playing = true
    refreshPlayingUI()
    updatePlayBtn()
    updateProgress(true)

    task.spawn(function()
        local ok, res = pcall(runSong, s, my)
        if not ok then res = "fail" end
        if my ~= token then return end -- replaced by another song or stopped
        cur = nil

        if res == "done" then failStreak = 0 else failStreak += 1 end
        if res == "stop" then return stopAll() end
        if autoIdx == 1 then
            stopAll()
            setStatus(res == "done" and "Done ✓" or "Stopped", res == "done" and "good" or "warn", 3)
            return
        end
        if res == "fail" and (autoIdx == 3 or failStreak >= 5) then
            stopAll()
            return
        end
        local nxt = (autoIdx == 3) and s or stepQueue(1)
        if nxt then playSong(nxt, true) else stopAll() end
    end)
end

