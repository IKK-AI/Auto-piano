---------------------------------------------------------------------
-- MIDI parser -> list of {time = seconds, n = note number}
---------------------------------------------------------------------
-- returns notes plus a "truncated" flag: true = the file ended before the last
-- chunk did, so what we read may be only part of the song (cut-off download)
local function parseMidi(s)
    assert(s:sub(1, 4) == "MThd", "not a MIDI file")
    local hlen = string.unpack(">I4", s, 5)
    local _, _, division = string.unpack(">I2I2I2", s, 9)
    if division >= 0x8000 or division == 0 then division = 480 end
    local pos = 9 + hlen
    local notes, tempos = {}, {}
    local truncated = false

    -- any read past the end just stops the walk: we keep the notes read so far
    local okWalk = pcall(function()
        local function vlq()
            local v = 0
            repeat
                if pos > #s then truncated = true error("eof") end
                local b = s:byte(pos)
                pos = pos + 1
                v = v * 128 + (b % 128)
            until b < 128
            return v
        end

        while pos + 7 <= #s do
            local id = s:sub(pos, pos + 3)
            local len = string.unpack(">I4", s, pos + 4)
            pos = pos + 8
            local stop = pos + len
            if stop > #s + 1 then truncated = true end -- chunk longer than the file

            if id == "MTrk" then
                local t, run = 0, nil
                while pos < stop and pos <= #s do
                    t = t + vlq()
                    local st = s:byte(pos)
                    if st >= 0x80 then
                        run = st
                        pos = pos + 1
                    else
                        st = run
                    end
                    if not st then truncated = true break end -- running status never set

                    if st == 0xFF then
                        local typ = s:byte(pos)
                        pos = pos + 1
                        local l = vlq()
                        if typ == 0x51 and l >= 3 and pos + 2 <= #s then
                            local a, b, c = s:byte(pos, pos + 2)
                            tempos[#tempos + 1] = { t = t, us = a * 65536 + b * 256 + c }
                        end
                        pos = pos + l
                    elseif st == 0xF0 or st == 0xF7 then
                        pos = pos + vlq()
                    elseif st == 0xF2 then
                        pos = pos + 2          -- song position: 2 data bytes
                    elseif st == 0xF1 or st == 0xF3 then
                        pos = pos + 1          -- MTC / song select: 1 data byte
                    elseif st >= 0xF4 and st <= 0xFE then
                        -- tune request / realtime: no data bytes (was: read 2, desyncing the track)
                    else
                        local hi = st - (st % 16)
                        if hi == 0xC0 or hi == 0xD0 then
                            pos = pos + 1
                        else
                            if pos + 1 > #s then truncated = true break end
                            local a, b = s:byte(pos, pos + 1)
                            pos = pos + 2
                            if hi == 0x90 and b > 0 and (st % 16) ~= 9 then
                                notes[#notes + 1] = { t = t, n = a }
                            end
                        end
                    end
                end
                if pos < stop then truncated = true end -- track data ran out early
            end
            pos = stop
        end
    end)
    if not okWalk then truncated = true end

    table.sort(tempos, function(a, b) return a.t < b.t end)
    table.sort(notes, function(a, b) return a.t < b.t end)

    local ti, curTempo, lastTick, sec = 1, 500000, 0, 0
    for _, n in ipairs(notes) do
        while tempos[ti] and tempos[ti].t <= n.t do
            sec = sec + (tempos[ti].t - lastTick) * curTempo / 1e6 / division
            lastTick = tempos[ti].t
            curTempo = tempos[ti].us
            ti = ti + 1
        end
        sec = sec + (n.t - lastTick) * curTempo / 1e6 / division
        lastTick = n.t
        n.time = sec
    end
    return notes, truncated
end

