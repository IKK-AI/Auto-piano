end

local function pickId(d)
    if not d then return nil end
    return d.id or d.task_id or (type(d.data) == "table" and (d.data.id or d.data.task_id)) or nil
end

local function pickStatus(d)
    if not d then return nil end
    return d.status or (type(d.data) == "table" and d.data.status) or nil
end

local function safeFileName(str)
    str = trim((str:gsub("[^%w\128-\255 _%-]", ""):gsub("%s+", " ")))
    local len = utf8.len(str)
    if len and len > 40 then str = str:sub(1, utf8.offset(str, 41) - 1) end
    return trim(str)
end

local function findLocalSong(fname)
    for _, sg in ipairs(songs) do
        if sg.localPath and ((sg.localPath:gsub("\\", "/")):match("([^/]+)$")) == fname .. ".mid" then
            return sg
        end
    end
    return nil
end

local tcBusy = false

local function hash8(str)
    local h = 5381
    for i = 1, #str do h = (h * 33 + str:byte(i)) % 4294967296 end
    return string.format("%08x", h)
end

-- POST one field to Opennan. urlencoded first (some mobile executors rewrite the
-- line endings of multipart bodies, which the API then cannot read at all), then
-- the documented multipart form, then JSON as a last resort
local function postField(field, value)
    local note = {}
    local lastRes, lastD

    local function tryRequest(how, opts)
        local ok, r = pcall(httpRequest, opts)
        if not ok or not r then
            note[#note + 1] = how .. ":fail"
            return false
        end
        lastRes, lastD = r, jsonOf(r)
        if (r.StatusCode and r.StatusCode < 400 and pickId(lastD)) or r.StatusCode == 429 then
            return true
        end
        note[#note + 1] = how .. ":" .. tostring(r.StatusCode)
        return false
    end

    if tryRequest("form", {
        Url = OPENNAN_API, Method = "POST",
        Headers = { ["Content-Type"] = "application/x-www-form-urlencoded", ["User-Agent"] = UA },
        Body = field .. "=" .. HttpService:UrlEncode(value),
    }) then return lastRes, lastD end

    local b = "----AutoPiano" .. (HttpService:GenerateGUID(false):gsub("%-", ""))
    if tryRequest("multi", {
        Url = OPENNAN_API, Method = "POST",
        Headers = { ["Content-Type"] = "multipart/form-data; boundary=" .. b, ["User-Agent"] = UA },
        Body = "--" .. b .. "\r\nContent-Disposition: form-data; name=\"" .. field .. "\"\r\n\r\n"
            .. value .. "\r\n--" .. b .. "--\r\n",
    }) then return lastRes, lastD end

    if tryRequest("json", {
        Url = OPENNAN_API, Method = "POST",
        Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = UA },
        Body = HttpService:JSONEncode({ [field] = value }),
    }) then return lastRes, lastD end

    return lastRes, lastD, table.concat(note, " ")
end

local lastCacheHit = { fname = nil, t = 0 }

local function transcribe(input, custom)
    input = trim(input or "")
    custom = trim(custom or "")
    if input == "" and custom ~= "" then input, custom = custom, "" end -- name typed in the second box only
    if tcBusy then return tcSay("กำลังแปลงอีกเพลงอยู่ รอให้เสร็จก่อนนะ", "warn") end
    if input == "" then return tcSay("ใส่ลิงก์ YouTube หรือชื่อเพลงก่อน", "warn") end
    if not httpRequest then return tcSay("executor ไม่รองรับ request()", "bad") end
    tcBusy = true

    task.spawn(function()
        local ok, err = pcall(function()
            -- the link can be pasted in either box, with text around it: fish it out
            local all = input .. " " .. custom
            local link = all:match("https?://[%w%p]+")
            if link then
                link = link:gsub('[<">].*$', "")   -- junk from HTML/JSON pastes (URLs never contain these)
                link = link:gsub("[%.%,%;%)%]%!%?%']+$", "") -- sentence punctuation around a pasted link
            end
            local isLink = link ~= nil
            local vid = isLink and (link:match("[?&]v=([%w_%-]+)") or link:match("youtu%.be/([%w_%-]+)") or link:match("/shorts/([%w_%-]+)")) or nil
            local inputRest = trim(((input:gsub("https?://[%w%p]+", " ")):gsub("%s+", " ")))
            local customRest = trim(((custom:gsub("https?://[%w%p]+", " ")):gsub("%s+", " ")))

            -- display name: custom name > words pasted around the link > the typed song name
            local title0 = customRest
            if title0 == "" and isLink and inputRest ~= "" then title0 = inputRest end
            if title0 == "" and not isLink then title0 = input end

            -- file name: unique per link, so two versions of one song never share a file
            local fname
            if title0 ~= "" then
                fname = safeFileName(title0)
                if isLink then fname = trim(fname .. " " .. (vid or hash8(link))) end
            elseif vid then
                fname = "YouTube " .. vid
            elseif isLink then
                fname = "Link " .. hash8(link)
            else
                fname = safeFileName(input)
            end
            if fname == "" then fname = "Song " .. hash8(all) end
            local fpath = LOCAL_FOLDER .. "/" .. fname .. ".mid"

            -- converted before? play the saved file (no quota used).
            -- press แปลง again within 30 s to delete it and convert anew.
            if isfile and isfile(fpath) then
                if lastCacheHit.fname == fname and os.clock() - lastCacheHit.t < 30 then
                    lastCacheHit.fname = nil
                    local del = delfile or removefile
                    if del then pcall(del, fpath) end
                    tcSay("ลบไฟล์เก่าแล้ว กำลังแปลงใหม่…", "warn")
                else
                    lastCacheHit.fname, lastCacheHit.t = fname, os.clock()
                    loadLocal()
                    sortSongs()
                    renderList()
                    local have = findLocalSong(fname)
                    if have then
                        showOverlay(nil)
                        tcSay("เคยแปลงเพลงนี้แล้ว เล่นไฟล์เดิมเลย (ไม่เสียโควตา) — กดปุ่มแปลงซ้ำอีกครั้งภายใน 30 วิ ถ้าอยากได้ไฟล์ใหม่", "good")
                        playSong(have)
                        return
                    end
                end
            end

            stopAll() -- never leave another song playing while we work
            tcSay("กำลังส่งไปแปลง…")

            -- url (a link) or search (a song name), sent by postField in several
            -- encodings until one is accepted
            local field, value = isLink and "url" or "search", isLink and link or input
            local res, d, note = postField(field, value)
            if not (res and res.StatusCode and res.StatusCode < 400 and pickId(d)) then
                if res and res.StatusCode == 429 then
                    return tcSay("ใช้ครบโควตาวันนี้แล้ว (ฟรี 3 เพลง/วัน) ลองใหม่พรุ่งนี้นะ", "bad")
                end
                if not res then
                    return tcSay("executor ส่ง request ไม่ออก (" .. tostring(note) .. ") — เช็คเน็ต/VPN แล้วลองใหม่", "bad")
                end
                return tcSay("ส่งไม่สำเร็จ" .. (note and note ~= "" and (" [" .. note .. "]") or "") .. " — " .. errText(res, d), "bad")
            end

            local base = OPENNAN_API .. "/" .. tostring(pickId(d))
            local t0 = os.clock()
            while true do
                local st = pickStatus(d)
                if st == "succeeded" then break end
                if st == "failed" then
                    return tcSay("แปลงไม่สำเร็จ: " .. errText(nil, d) .. " (ไม่เสียโควตา)", "bad")
                end
                if os.clock() - t0 > TRANSCRIBE_TIMEOUT then
                    return tcSay("รอนานเกินไป ลองกดแปลงใหม่อีกครั้ง", "bad")
                end
                -- show the real stage / queue position / progress when the server reports them
                local bits = { "กำลังแปลง… " .. fmt(os.clock() - t0) }
                local stage = d.stage or (type(d.data) == "table" and d.data.stage)
                if type(stage) == "string" and stage ~= "" and stage ~= st then bits[#bits + 1] = stage end
                if st == "queued" and type(d.position) == "number" and d.position > 0 then
                    bits[#bits + 1] = "คิวที่ " .. d.position
                end
                if type(d.progress) == "number" and d.progress > 0 then
                    bits[#bits + 1] = math.floor(d.progress * 100) .. "%"
                end
                if type(d.eta_seconds) == "number" and d.eta_seconds > 1 then
                    bits[#bits + 1] = "เหลืออีก ~" .. fmt(d.eta_seconds)
                end
                tcSay(table.concat(bits, " · "))
                task.wait(3)
                d = getJson(base) or d
            end

            tcSay("กำลังโหลด MIDI…")
            local midi = httpGet(base .. "/midi")
            if not midi or midi:sub(1, 4) ~= "MThd" then
                -- the finished job also carries a direct URL to the file
                local alt = nil
                if type(d.midi_url) == "string" and d.midi_url ~= "" then
                    alt = d.midi_url
                elseif type(d.outputs) == "table" and type(d.outputs[1]) == "table" and type(d.outputs[1].url) == "string" then
                    alt = d.outputs[1].url
                end
                if alt then midi = httpGet(alt) end
            end
            if not midi or midi:sub(1, 4) ~= "MThd" then
                return tcSay("โหลดไฟล์ MIDI ไม่ได้ ลองกดแปลงอีกครั้ง", "bad")
            end
            local okN, nn, trunc = pcall(parseMidi, midi)
            if okN and trunc then -- the file arrived cut short: try once more
                tcSay("ไฟล์มาไม่ครบ ลองโหลดใหม่…", "warn")
                local m2 = httpGet(base .. "/midi")
                if m2 and m2 ~= midi and m2:sub(1, 4) == "MThd" then
                    local okN2, nn2, tr2 = pcall(parseMidi, m2)
                    if okN2 and type(nn2) == "table" and (not okN or type(nn) ~= "table" or #nn2 > #nn) then
                        midi, nn, trunc = m2, nn2, tr2
                    end
                end
            end
            if not okN or type(nn) ~= "table" or #nn == 0 then
                return tcSay("ได้ไฟล์ MIDI แต่ไม่มีโน้ตเลย (ลองใช้วิดีโอเปียโนแทน)", "bad")
            end

            -- the server knows the real title: nicer list entry + better lyrics search
            local dispName = title0
            if dispName == "" then dispName = realText(d.title) end
            if dispName == "" then dispName = (vid and ("YouTube " .. vid)) or (isLink and ("Link " .. hash8(link))) or input end

            local song
            if writefile then
                pcall(function()
                    if makefolder and isfolder and not isfolder(LOCAL_FOLDER) then makefolder(LOCAL_FOLDER) end
                    writefile(fpath, midi)
                end)
                if isfile and isfile(fpath) then
                    fileTitles[fname .. ".mid"] = dispName
                    saveData()
                    loadLocal()
                    song = findLocalSong(fname)
                end
            end
            if not song then
                -- executor can't save files: keep it in memory for this session
                local memKey = "opennan:" .. tostring(pickId(d))
                addSong(dispName, { body = midi, mem = memKey, tag = "Opennan" })
                for _, sg in ipairs(songs) do
                    if sg.mem == memKey then song = sg break end
                end
            end
            if song then
                song.label = dispName
                song.sk = norm(dispName)
                song.l = song.sk .. " " .. norm(fname)
                song.l2 = (song.l:gsub(" ", ""))
            end
            sortSongs()
            renderList()
            showOverlay(nil)
            if not song then return tcSay("แปลงได้แล้วแต่หาไฟล์ในลิสต์ไม่เจอ", "bad") end

            -- warn when the result covers clearly less than the source audio
            local extra = ""
            if type(d.duration) == "number" and d.duration >= 30 and d.duration < 3600
                and nn[#nn].time < d.duration * 0.55 then
                extra = " · สั้นกว่าต้นฉบับ (" .. fmt(nn[#nn].time) .. "/" .. fmt(d.duration) .. ")"
            end
            if type(d.notes) == "number" and d.notes >= 50 and #nn < d.notes * 0.5 then
                extra = extra .. " · โน้ตอาจไม่ครบ"
            end
            tcSay("แปลงเสร็จ ✓ " .. dispName .. " · " .. #nn .. " โน้ต · " .. fmt(nn[#nn].time) .. extra, "good")
            playSong(song)
        end)
        tcBusy = false
        if not ok then tcSay("error: " .. tostring(err), "bad") end
    end)
end

